<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless NX adapter layer: the only place NXOpen types touch material assignment. No BlockStyler,
    no WinForms, so a batch/ugbatch caller or a future non-BlockUI front end can reference this without
    dragging a dialog in. The Block UI Styler dialog lives in BAMaterial.Ui.

    In NxMaterialAssignment.sln so it loads in the IDE and gets IntelliSense/analyzer feedback, but
    with no Build.0 entry in any configuration: it references real NXOpen/UFSession assemblies that
    only resolve where NX is installed (UGII_BASE_DIR set), so building it by default would break
    `dotnet build` / `dotnet test` everywhere else. Build it explicitly on an NX machine:
    `dotnet build BAMaterial.Adapter\BAMaterial.Adapter.csproj`.
  -->

  <!-- NXOpen references + the UGII_BASE_DIR guard. Explicit Import, not Directory.Build.props, so the
       guard cannot fire on a project that must build without NX installed. -->
  <Import Project="..\build\Nx.References.props" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Foundation.Contracts is used directly (OperationResult, Material, MaterialLibrary, BodyId).
      Foundation.Core arrives transitively via Core.Materials, but stays listed: Core.Materials exposes
      Foundation.Core.RuleEngine types (RuleOutcome) on its public surface, so relying on the implicit
      dependency is a CS0012 waiting to happen.
      Foundation.Core.Materials carries the assignment engine this project implements IPartMaterialService
      for; it replaces the former BAMaterial.Core.
      Foundation.NxAdapters (NxSessionContext, NxListingLog, NxMessageBoxHelper, UndoScope) has no
      other path into this project and must be referenced directly.
    -->
    <ProjectReference Include="..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.Contracts\BANxOpen.Foundation.Contracts.csproj" />
    <ProjectReference Include="..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.Core\BANxOpen.Foundation.Core.csproj" />
    <ProjectReference Include="..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.Core.Materials\BANxOpen.Foundation.Core.Materials.csproj" />
    <ProjectReference Include="..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.NxAdapters\BANxOpen.Foundation.NxAdapters.csproj" />
  </ItemGroup>

</Project>
