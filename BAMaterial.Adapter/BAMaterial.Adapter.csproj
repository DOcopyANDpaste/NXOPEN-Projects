<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless NX adapter layer: the only place NXOpen types touch material assignment. No BlockStyler,
    no WinForms, so a batch/ugbatch caller or a future non-BlockUI front end can reference this without
    dragging a dialog in. The Block UI Styler dialog lives in BAMaterial.Ui.

    In NxMaterialAssignment.sln so it loads in the IDE and gets IntelliSense/analyzer feedback, but
    with no Build.0 entry in any configuration: it references real NXOpen/UFSession assemblies that
    only resolve where NX is installed (UGII_BASE_DIR set), so building it by default would break
    `dotnet build` / `dotnet test` everywhere else. Build it explicitly on an NX machine:
    `dotnet build BAMaterial.Adapter\BAMaterial.Adapter.csproj`.
  -->

  <!-- NXOpen references + the UGII_BASE_DIR guard. Explicit Import, not Directory.Build.props: the
       guard must not fire on BAMaterial.Core or BAMaterial.Core.Tests. -->
  <Import Project="..\build\Nx.References.props" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BAMaterial.Core\BAMaterial.Core.csproj" />
    <!--
      Foundation.Contracts is used directly (OperationResult, Material, MaterialLibrary).
      Foundation.Core arrives transitively via BAMaterial.Core, but stays listed: BAMaterial.Core
      exposes Foundation.Core.RuleEngine types (RuleOutcome) on its public surface, so relying on the
      implicit dependency is a CS0012 waiting to happen.
      Foundation.NxAdapters (NxSessionContext, NxListingLog, NxMessageBoxHelper, UndoScope) has no
      other path into this project and must be referenced directly.
    -->
    <ProjectReference Include="..\..\NxOpen.Foundation\src\NxOpen.Foundation.Contracts\NxOpen.Foundation.Contracts.csproj" />
    <ProjectReference Include="..\..\NxOpen.Foundation\src\NxOpen.Foundation.Core\NxOpen.Foundation.Core.csproj" />
    <ProjectReference Include="..\..\NxOpen.Foundation\src\NxOpen.Foundation.NxAdapters\NxOpen.Foundation.NxAdapters.csproj" />
  </ItemGroup>

</Project>
