<Project>

  <!--
    Shared NXOpen wiring for the two projects that need NX installed: BAMaterial.Adapter and
    BAMaterial.Ui. Imported EXPLICITLY by each of them, not auto-imported via Directory.Build.props,
    because the RequireUgiiBaseDir guard below must not fire on BAMaterial.Core or
    BAMaterial.Core.Tests. Those two must keep building and testing on machines without NX.

    Per Skills/common.md non-negotiable #4: no hardcoded install paths, reference via UGII_BASE_DIR.
    Verified against NX 2412: the managed assemblies live in NXBIN\managed (net48), NOT directly under
    $(UGII_BASE_DIR)\managed. NXBIN\managed_core is the .NET-Core-targeted copy; both consumers here
    are net48, so they want the former.

    Every reference is Private=False: NX loads its own copies, so they must never be copied to output.

    NOTE: System.Windows.Forms and System.Drawing are NOT here. They back the WinForms material
    property popup and belong to BAMaterial.Ui alone, which declares them itself. Keeping
    BAMaterial.Adapter free of them is the point of the UI split.
  -->

  <Target Name="RequireUgiiBaseDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(UGII_BASE_DIR)' == ''"
           Text="UGII_BASE_DIR is not set. This project references the NXOpen managed assemblies and can only be built on a machine with NX installed." />
  </Target>

  <PropertyGroup>
    <NxManagedDir>$(UGII_BASE_DIR)\NXBIN\managed</NxManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Session, Part, Body, PhysicalMaterial, NXException. -->
    <Reference Include="NXOpen">
      <HintPath>$(NxManagedDir)\NXOpen.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- UFSession.Disp / .Modl, used by the adapter's DisplayMaterialHelper and PartMaterialService. -->
    <Reference Include="NXOpen.UF">
      <HintPath>$(NxManagedDir)\NXOpen.UF.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- NXOpen.Tag / NXOpen.TaggedObject live here, not in NXOpen.dll. The adapter names Tag in method
         signatures; the UI keys tree nodes on TaggedObject and reads it back out of
         PropertyList.GetTaggedObjectVector. -->
    <Reference Include="NXOpen.Utilities">
      <HintPath>$(NxManagedDir)\NXOpen.Utilities.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- NXOpen.BlockStyler (BlockDialog, Tree, Node, TreeListMenu, PropertyList, SelectObject, ...)
         ships in NXOpenUI.dll, NOT NXOpen.dll, confirmed against the NX 2412 install. Also carries
         NXOpen.UI / NXMessageBox, which is why the adapter wants it too: NxPhysicalMaterialSource
         defaults confirmLoad to NxMessageBoxHelper.Confirm and NxSessionContext.Ui is an NXOpen.UI. -->
    <Reference Include="NXOpenUI">
      <HintPath>$(NxManagedDir)\NXOpenUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
