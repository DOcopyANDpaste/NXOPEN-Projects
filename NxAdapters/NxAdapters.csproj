<Project Sdk="Microsoft.NET.Sdk">

  <!--
    In NxMaterialAssignment.sln so it loads in the IDE and gets IntelliSense/analyzer feedback, but with
    no Build.0 entry in any configuration — it references real NXOpen/UFSession assemblies that only
    resolve where NX is installed (UGII_BASE_DIR set), so building it by default would break
    `dotnet build`/`dotnet test` everywhere else. Build it explicitly on an NX machine:
    `dotnet build NxAdapters\NxAdapters.csproj`.
  -->

  <Target Name="RequireUgiiBaseDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(UGII_BASE_DIR)' == ''"
           Text="UGII_BASE_DIR is not set. This project references the NXOpen managed assemblies and can only be built on a machine with NX installed." />
  </Target>

  <ItemGroup>
    <!-- The dialog's composition root and presenter use Core's planner/finalizer/rules/grouper types,
         and the shared side-effect Data keys, directly. -->
    <ProjectReference Include="..\Core\Core.csproj" />
    <!--
      Foundation references: Contracts/Core come in transitively via Core.csproj's own references, but
      are listed explicitly here too since this project uses their types directly (MaterialLibraryParser,
      CachingMaterialLibraryLoader, FileSystemMaterialLibraryRepository, etc.). NxAdapters is the one
      foundation project that must be referenced directly — it has no other path into this project.
    -->
    <ProjectReference Include="..\..\NxOpen.Foundation\src\NxOpen.Foundation.Contracts\NxOpen.Foundation.Contracts.csproj" />
    <ProjectReference Include="..\..\NxOpen.Foundation\src\NxOpen.Foundation.Core\NxOpen.Foundation.Core.csproj" />
    <ProjectReference Include="..\..\NxOpen.Foundation\src\NxOpen.Foundation.NxAdapters\NxOpen.Foundation.NxAdapters.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <!--
    Per Skills/common.md non-negotiable #4: no hardcoded install paths, reference via UGII_BASE_DIR.
    Managed-assembly folder name/layout ("managed\NXOpen.dll", "managed\NXOpen.UF.dll") is the common
    convention for recent NX versions but is NOT verified against a real install — confirm and correct
    against your installed NX version before this will resolve.
  -->
  <ItemGroup>
    <Reference Include="NXOpen">
      <HintPath>$(UGII_BASE_DIR)\managed\NXOpen.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NXOpen.UF">
      <HintPath>$(UGII_BASE_DIR)\managed\NXOpen.UF.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!--
    VERIFY: NXOpen.BlockStyler types (used by Ui/BlockAccessor.cs, Ui/MaterialAssignmentDialog.cs) are
    assumed to resolve from the NXOpen reference above. If the installed NX version ships Block UI Styler
    types in a separate managed assembly instead, add a Reference for it here the same way, via
    $(UGII_BASE_DIR)\managed\.
  -->

</Project>
